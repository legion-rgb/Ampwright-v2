{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Ampwright__.*",
        "hooks": [{"type": "command", "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/checks/hook_guard.py\""}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__Ampwright__connect",
        "hooks": [{"type": "command", "command": "uv run --script \"$CLAUDE_PROJECT_DIR/checks/hook_tidy.py\""}]
      }
    ]
  }
}
